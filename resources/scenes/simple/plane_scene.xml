<!-- Simple plane scene for basic structured light tests -->
<scene version="3.0.0">
    <!-- Integrator -->
    <integrator type="path"/>

    <!-- Sensor (Camera) -->
    <sensor type="perspective">
        <float name="fov" value="45"/>
        <transform name="to_world">
            <lookat origin="0, 0, 3" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <film type="hdrfilm">
            <integer name="width" value="1920"/>
            <integer name="height" value="1080"/>
        </film>
        <sampler type="independent">
            <integer name="sample_count" value="32"/>
        </sampler>
    </sensor>

    <!-- Emitter (Light) -->
    <emitter type="point">
        <point3 name="position" value="0, 2, 2"/>
        <rgb name="intensity" value="1 1 1"/>
    </emitter>

    <!-- Simple plane geometry -->
    <shape type="rectangle">
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.8 0.8 0.8"/>
        </bsdf>
    </shape>

    <!-- Simple shapes for depth variation -->
    <shape type="sphere">
        <transform name="to_world">
            <translate x="-0.5" y="0" z="0"/>
            <scale value="0.3"/>
        </transform>
        <ref id="white_mat"/>
    </shape>

    <bsdf type="diffuse" id="white_mat">
        <rgb name="reflectance" value="0.9 0.9 0.9"/>
    </bsdf>
</scene>
