    "sfm": {
      "colmap_bin": "colmap",
      "matcher": "sequential",
      "camera_model": "PINHOLE",
      "single_camera": true,
      "dense": false
    },
    "3dgs": {
      "repo_dir": "assets/external/code/gaussian-splatting",
      "python_bin": "python",
      "iterations": 7000,
      "resolution": null,
      "extra_args": []
    },
    "nerf": {
      "process_bin": "ns-process-data",
      "train_bin": "ns-train",
      "method": "nerfacto",
      "max_num_iterations": 30000,
      "downscale_factor": null,
      "skip_process_data": false
    }
  }
}
