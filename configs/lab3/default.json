{
  "input_dir": "docs/lab1/assets/videos",
  "scene_name": "lab1_sample",
  "output_root": "outputs/lab3",
  "methods": ["sfm", "3dgs", "nerf"],
  "fps": 2.0,
  "test_ratio": 0.1,
  "image_limit": null,
  "ffmpeg_bin": "ffmpeg",
