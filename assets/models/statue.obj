# Simple statue-like geometry created from spheres
# This creates an abstract humanoid form using multiple spheres

# Vertices (x, y, z)
v -0.2  0.0  1.5   # head center
v -0.2  0.0  1.5   # duplicate for separate vertex lists
v -0.2  0.0  1.5
v  0.2  0.0  1.5   # head left
v  0.2  0.0  1.5
v  0.2  0.0  1.5
v -0.3  0.1  1.6   # head top
v -0.3  0.1  1.6
v -0.3  0.1  1.6
v  0.0  0.1  1.6   # head top-center
v  0.0  0.1  1.6
v  0.0  0.1  1.6
v  0.3  0.1  1.6   # head top-right
v  0.3  0.1  1.6
v  0.3  0.1  1.6
v -0.2 -0.1  1.4   # head bottom
v -0.2 -0.1  1.4
v -0.2 -0.1  1.4
v  0.2 -0.1  1.4   # head bottom-right
v  0.2 -0.1  1.4
v  0.2 -0.1  1.4

# Neck/Shoulders
v -0.4 -0.3  1.3
v -0.4 -0.3  1.3
v -0.4 -0.3  1.3
v  0.4 -0.3  1.3
v  0.4 -0.3  1.3
v  0.4 -0.3  1.3
v -0.5 -0.5  1.2   # left shoulder
v -0.5 -0.5  1.2
v -0.5 -0.5  1.2
v  0.5 -0.5  1.2   # right shoulder
v  0.5 -0.5  1.2
v  0.5 -0.5  1.2

# Torso
v -0.3 -0.7  1.25
v -0.3 -0.7  1.25
v -0.3 -0.7  1.25
v  0.3 -0.7  1.25
v  0.3 -0.7  1.25
v  0.3 -0.7  1.25

# Base
v -0.4 -1.0  1.2
v -0.4 -1.0  1.2
v -0.4 -1.0  1.2
v  0.4 -1.0  1.2
v  0.4 -1.0  1.2
v  0.4 -1.0  1.2

# Texture coordinates (u, v)
vt 0.0 0.0
vt 1.0 0.0
vt 0.5 1.0

# Normals (x, y, z) - smoothed for organic look
vn 0.0  0.0  1.0
vn  0.5  0.0  0.866
vn -0.5  0.0  0.866
vn 0.0  0.866  0.5
vn 0.0 -0.866  0.5

# Faces (vertex/texture/normal indices)
# Head spheres
f 1/1/1 2/2/2 3/3/3
f 4/1/2 5/2/2 6/3/2
f 7/1/3 8/2/3 9/3/3
f 10/1/4 11/2/4 12/3/4
f 13/1/5 14/2/5 15/3/5
f 16/1/1 17/2/2 18/3/3
f 19/1/2 20/2/2 21/3/2

# Shoulders
f 22/1/3 23/2/3 24/3/3
f 25/1/4 26/2/4 27/3/4
f 28/1/5 29/2/5 30/3/5
f 31/1/3 32/2/3 33/3/3

# Torso
f 34/1/1 35/2/2 36/3/3
f 37/1/2 38/2/2 39/3/2

# Base
f 40/1/3 41/2/3 42/3/3
f 43/1/4 44/2/4 45/3/4
