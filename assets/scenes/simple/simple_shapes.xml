<!-- Simple inline geometric shapes for basic Lab2 experiments -->
<!-- These can be directly included in scene XML files -->

<!-- Basic sphere -->
<shape type="sphere">
    <transform name="to_world">
        <translate x="0" y="0" z="0"/>
        <scale value="0.2"/>
    </transform>
    <bsdf type="diffuse">
        <rgb name="reflectance" value="0.9 0.9 0.9"/>
    </bsdf>
</shape>

<!-- Basic cube -->
<shape type="cube">
    <transform name="to_world">
        <translate x="0.5" y="-0.1" z="0"/>
        <scale value="0.15"/>
    </transform>
    <bsdf type="diffuse">
        <rgb name="reflectance" value="0.8 0.8 0.8"/>
    </bsdf>
</shape>

<!-- Plane (ground) -->
<shape type="rectangle">
    <transform name="to_world">
        <translate x="0" y="-0.3" z="0"/>
        <scale value="2"/>
    </transform>
    <bsdf type="diffuse">
        <rgb name="reflectance" value="0.5 0.5 0.5"/>
    </bsdf>
</shape>
