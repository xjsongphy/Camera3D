<!-- Template scene for loading external .obj models -->
<!-- Usage: Replace MODEL_FILE.obj with your actual model filename -->
<scene version="3.0.0">
    <!-- Integrator -->
    <integrator type="path"/>

    <!-- Sensor (Camera) -->
    <sensor type="perspective">
        <float name="fov" value="45"/>
        <transform name="to_world">
            <lookat origin="0, 0.5, 2" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <film type="hdrfilm">
            <integer name="width" value="1920"/>
            <integer name="height" value="1080"/>
        </film>
        <sampler type="independent">
            <integer name="sample_count" value="64"/>
        </sampler>
    </sensor>

    <!-- Emitter (Light) -->
    <emitter type="area">
        <shape type="rectangle">
            <transform name="to_world">
                <translate x="0" y="2" z="1"/>
                <rotate x="1" angle="180"/>
                <scale value="0.5"/>
            </transform>
        </shape>
        <rgb name="radiance" value="4 4 4"/>
    </emitter>

    <!-- Load external .obj model -->
    <!-- Note: Make sure the .obj file exists in assets/geometry/obj/ -->
    <shape type="obj">
        <string name="filename" value="assets/geometry/obj/MODEL_FILE.obj"/>
        <transform name="to_world">
            <!-- Adjust scale as needed -->
            <scale value="0.01"/>
        </transform>
        <!-- Apply material -->
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.8 0.8 0.8"/>
        </bsdf>
    </shape>

    <!-- Ground plane -->
    <shape type="rectangle">
        <transform name="to_world">
            <translate x="0" y="-0.5" z="0"/>
            <scale value="2"/>
        </transform>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.5 0.5 0.5"/>
        </bsdf>
    </shape>
</scene>
